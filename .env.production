# ==============================================================================
# .env.production — 前端正式部署環境變數
# 執行 `npm run build` 時 Vite 自動載入此檔
# ==============================================================================

# API 指向同網域 Vercel Serverless FastAPI（由 vercel.json rewrites 分流）
VITE_API_BASE_URL=/api

# 應用程式環境識別
VITE_APP_ENV=production